# ==============================================================================
# GoldenMinutes - Environment Configuration Template
# Copy this file to .env or .env.local and populate with your credentials.
# NEVER commit your real .env file with secrets to Git.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Gemini AI API Key (Used in server.ts for Paramedic SBAR Voice-to-Clinical Handover)
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Public Application URL (Optional for production hosting)
APP_URL="http://localhost:3000"

# Firebase Client Configuration (Optional overrides; defaults bundled for demo in firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
